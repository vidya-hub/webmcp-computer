# Copy to deploy/.env and fill in secrets. deploy/.env is gitignored.

# --- Postgres (dedicated container: deploy/compose.postgres.yml) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://webmcp:change-me@127.0.0.1:55432/webmcp

# --- MinIO (reuse existing svg-emb-minio via a scoped service account) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=webmcp-computer
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- API / control plane ---
PORT=8787
COMPUTER_IMAGE=webmcp-slim:local
STORAGE_BACKEND=pg
TAPE_CAP=100
MAX_COMPUTERS=4
# docker = require Docker (exit if unavailable), memory = force in-memory fake,
# auto = fall back to memory if Docker probe fails (dev only).
HOST_BACKEND=docker
# Browser origins allowed to drive the control plane (CSRF/WS guard). MUST list
# the deployed origin or the app's own POSTs are rejected. Comma-separated.
ALLOWED_ORIGINS=https://vidyaoracle.tailc57b59.ts.net,http://127.0.0.1:5173,http://localhost:5173
