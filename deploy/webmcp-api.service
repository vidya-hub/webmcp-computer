[Unit]
Description=webmcp-computer control plane (API)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/homelab/webmcp-computer
EnvironmentFile=/home/ubuntu/homelab/webmcp-computer/deploy/.env
Environment=PATH=/usr/local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/homelab/webmcp-computer/apps/api/node_modules/.bin/tsx apps/api/src/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
