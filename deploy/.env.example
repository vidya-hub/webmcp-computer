# Copy to deploy/.env and fill in secrets. deploy/.env is gitignored.

# --- Postgres (dedicated container: deploy/compose.postgres.yml) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://webmcp:change-me@127.0.0.1:55432/webmcp

# --- MinIO (reuse existing svg-emb-minio via a scoped service account) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=webmcp-computer
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- API / control plane ---
PORT=8787
COMPUTER_IMAGE=webmcp-slim:local
STORAGE_BACKEND=pg
TAPE_CAP=100
MAX_COMPUTERS=4
# docker = require Docker (exit if unavailable), memory = force in-memory fake,
# auto = fall back to memory if Docker probe fails (dev only).
HOST_BACKEND=docker
# Browser origins allowed to drive the control plane (CSRF/WS guard). MUST list
# the deployed origin or the app's own POSTs are rejected. Comma-separated.
ALLOWED_ORIGINS=https://vidyaoracle.tailc57b59.ts.net,https://computer.vsagar.net,http://127.0.0.1:5173,http://localhost:5173

# --- Redis (dedicated container: deploy/compose.postgres.yml) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (apps/auth on :8788) ---
# JWT signing secret; generate with: openssl rand -base64 48
JWT_SECRET=change-me
# JWT_SECRET_PREVIOUS=   # set only during a secret rotation
# Require a valid session on every /api/* and /desktops request. Set on the API
# unit for the same restart that runs migration 003.
AUTH_REQUIRED=true
AUTH_PORT=8788
# Cookies are Secure (HTTPS). The tailnet edge (Tailscale Serve) terminates TLS.
AUTH_COOKIE_SECURE=true
# Whether the login form is offered at all (false = closed-access screen).
AUTH_PUBLIC_LOGIN=true
# Only these emails may sign in (lowercased). Bootstrap emails are always allowed.
AUTH_ALLOWLIST=you@example.com,teammate@example.com
# Seed these accounts at boot with AUTH_BOOTSTRAP_PASSWORD (never commit it).
AUTH_BOOTSTRAP_EMAILS=you@example.com,teammate@example.com
AUTH_BOOTSTRAP_PASSWORD=
# Default per-user computer quota (DB `quotas` seeds from this on user creation).
DEFAULT_QUOTA_COMPUTERS=4
